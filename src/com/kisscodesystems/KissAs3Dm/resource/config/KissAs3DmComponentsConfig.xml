<?xml version="1.0" encoding="UTF-8"?>
<!--
  The components configuration of the KissAs3Dm application.

  Every value that is missing from here keeps the one the framework gives it in
  KissAs3FwComponentsConfig.xml, or the default coded into the ComponentsConfig class.

  To override any of those, add a value element here with the key of that value. The
  list of the available keys is the KissAs3FwComponentsConfig.xml of the framework:

    <value key="widgetsMargin">0</value>
    <value key="widgetEnableManualResize">false</value>

  This file is embedded and applied by ComponentsConfigDemo, so overriding a framework
  default only means writing a line into this xml, no code has to be touched.
-->
<config name="ComponentsConfig">
  <!--
    The framework starts a camera at 640 pixels, and both demos of this application display
    that camera among many other components on one single screen: the widget of the camera
    is about 528 pixels wide inside in mobile mode, so a 640 pixel picture does not fit in
    it at all - it pushes the rows of the properties of that widget into a strip of a
    couple of lines and takes a hundred pixels of every one of them out of reach. 480 is
    the widest four by three mode of the framework that fits, and it is one of the fixed
    presets of an iphone as well.
  -->
  <value key="cameraWidthIni">480</value>
</config>
